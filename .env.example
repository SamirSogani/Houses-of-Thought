# Supabase — copy this file to .env and fill in your values.
# Find these in your Supabase dashboard: Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq — two-tier resilient inference (server-side only). console.groq.com
# Tier 1 is the default for everything; on HTTP 429 (or low-effort work under
# heavy traffic) the request falls to Tier 2. One key per tier.
# Tier 1 (standard, heavy reasoning): qwen/qwen3.6-27b
GROQ_QWEN_3_POINT_6_27B_API_KEY=your-groq-qwen-key
# Tier 2 (fast fallback): openai/gpt-oss-20b
GROQ_OPENAI_GPT_OSS_20B_API_KEY=your-groq-gpt-oss-20b-key
# Optional model overrides (env wins over the built-in tier defaults):
# GROQ_TIER1_MODEL= / GROQ_TIER2_MODEL=
# Brave Search — evidence research (server-side only). brave.com/search/api
BRAVE_SEARCH_API_KEY=your-brave-key
